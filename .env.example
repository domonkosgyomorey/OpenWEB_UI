## Copy this file to .env and edit before running `docker compose`.

# Pinned Open WebUI release tag (set to a verified release/tag). Do NOT set to "latest" or "main" in production.
OPEN_WEBUI_VERSION=REPLACE_WITH_OPEN_WEBUI_RELEASE_TAG

# Host port mapped on the Raspberry Pi host (localhost binding). Default: 3000
HOST_PORT=3000

# DeepSeek API key (do NOT commit your key). Place your production key in .env.
DEEPSEEK_API_KEY=

# Persistent secret for Open WebUI. Generate once and keep it in .env.
# Example generation: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Optional: DeepSeek/OpenAI-compatible base URL if required by DeepSeek (leave blank to use default OpenAI base).
DEEPSEEK_API_BASE=

# Optional: default model identifier to request from DeepSeek/OpenAI-compatible API.
DEEPSEEK_MODEL=
